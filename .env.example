# GEMINI_API_KEY: Required for Gemini AI API calls (Google AI Studio Free Tier).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: (Optional) Groq Cloud Ultra-Fast Free AI Engine (Llama 3.3 70B & DeepSeek R1).
# Free registration at: https://console.groq.com/keys
GROQ_API_KEY="MY_GROQ_API_KEY"

# OPENROUTER_API_KEY: (Optional) Gateway for DeepSeek R1, Claude, and Llama 3 free models.
# Free registration at: https://openrouter.ai/keys
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# MISTRAL_API_KEY: (Optional) Mistral AI (Mistral Small / Codestral Free Tier).
# Free registration at: https://console.mistral.ai/api-keys/
MISTRAL_API_KEY="MY_MISTRAL_API_KEY"

# COHERE_API_KEY: (Optional) Cohere Command R+ Trial Tier for Deep Fact Reranking & Web Grounding.
# Free registration at: https://dashboard.cohere.com/api-keys
COHERE_API_KEY="MY_COHERE_API_KEY"

# HUGGINGFACE_API_KEY: (Optional) Hugging Face Serverless Inference Token for Qwen 2.5 72B & Open Models.
# Free registration at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY="MY_HUGGINGFACE_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

